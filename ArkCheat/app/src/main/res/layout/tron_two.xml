<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/fire_bg">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:paddingTop="70dp" android:paddingBottom="60dp"
            android:paddingStart="24dp" android:paddingEnd="24dp">

            <!-- Circular logo in fire frame -->
            <FrameLayout android:layout_width="150dp" android:layout_height="150dp"
                android:background="@drawable/fire_logo_frame" android:padding="6dp"
                android:layout_gravity="center_horizontal">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ark_logo_circle" android:scaleType="fitCenter"/>
            </FrameLayout>

            <Space android:layout_width="0dp" android:layout_height="26dp"/>

            <!-- ArkCheat cursive glowing title — text/color set in setTitle() to avoid flash -->
            <TextView android:id="@+id/splashTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFF7A18" android:textSize="46sp"
                android:fontFamily="@font/pacifico"
                android:layout_gravity="center_horizontal"
                android:paddingEnd="10dp"
                android:shadowColor="#FFFF6A02"
                android:shadowDx="0" android:shadowDy="0" android:shadowRadius="30"/>

            <Space android:layout_width="0dp" android:layout_height="70dp"/>

            <!-- BIG LOGIN BOX -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/fire_login_box"
                android:orientation="vertical"
                android:paddingStart="26dp" android:paddingEnd="26dp"
                android:paddingTop="30dp" android:paddingBottom="30dp">

                <!-- Label -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ACCESS KEY"
                    android:textColor="#8A7A6A" android:textSize="14sp" android:textStyle="bold"
                    android:letterSpacing="0.16" android:layout_marginBottom="16dp"
                    android:layout_marginStart="4dp"/>

                <!-- Key input box -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:background="@drawable/fire_input"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="8dp">

                    <EditText android:id="@+id/et1"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="ENTER KEY" android:textColorHint="#5A4A3E"
                        android:textColor="#FFFFFF" android:textSize="17sp"
                        android:letterSpacing="0.05"
                        android:inputType="textPassword" android:singleLine="true"/>

                    <ImageButton android:id="@+id/eyeToggle"
                        android:layout_width="46dp" android:layout_height="46dp"
                        android:src="@drawable/ic_eye_off"
                        android:background="@android:color/transparent"
                        android:scaleType="center" android:padding="11dp"
                        android:contentDescription="Toggle visibility"/>
                </LinearLayout>

                <Space android:layout_width="0dp" android:layout_height="26dp"/>

                <!-- LOGIN button (fire gradient, square curved) -->
                <androidx.cardview.widget.CardView android:id="@+id/btnSignIn"
                    android:layout_width="match_parent" android:layout_height="60dp"
                    app:cardBackgroundColor="#00000000"
                    app:cardCornerRadius="16dp" app:cardElevation="0dp">

                    <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/fire_button"
                        android:text="LOGIN" android:textColor="#FFFFFF"
                        android:textSize="18sp" android:textStyle="bold"
                        android:gravity="center" android:letterSpacing="0.12"/>
                </androidx.cardview.widget.CardView>

                <Space android:layout_width="0dp" android:layout_height="18dp"/>

                <!-- PASTE button -->
                <TextView android:id="@+id/img1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PASTE"
                    android:textColor="#FF6A02" android:textSize="15sp" android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:padding="10dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="Paste"/>

            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="20dp"/>

            <!-- Facebook Clone / Launch button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnFbClone"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                app:cardBackgroundColor="#1A0800"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:strokeColor="#FF6A02"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/btnFbCloneText"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="CLONE FACEBOOK"
                    android:textColor="#FF7A18"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- PROCESSING CARD -->
    <LinearLayout android:id="@+id/processingCard"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/fire_login_box"
        android:orientation="vertical"
        android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="22dp" android:paddingBottom="22dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="30dp" android:layout_height="30dp"
                android:indeterminate="true" style="?android:attr/progressBarStyle"
                android:indeterminateTint="#FF6A02" android:layout_marginEnd="14dp"/>

            <TextView android:id="@+id/loadingText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Processing" android:textColor="#FFFFFF"
                android:textSize="20sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:id="@+id/versionText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#9A8C7A" android:textSize="13sp"
            android:visibility="gone" android:layout_marginBottom="2dp"/>

        <TextView android:id="@+id/progressText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#9A8C7A" android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <ProgressBar android:id="@+id/downloadProgressBar"
            android:layout_width="match_parent" android:layout_height="10dp"
            android:progressDrawable="@drawable/glass_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100" android:progress="0"
            android:visibility="gone" android:layout_marginBottom="8dp"/>

        <LinearLayout android:id="@+id/speedRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:visibility="gone">

            <TextView android:id="@+id/downloadSizeText"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text=""
                android:textColor="#9A8C7A" android:textSize="12sp"/>

            <TextView android:id="@+id/percentText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FF6A02"
                android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:id="@+id/speedText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#6E5F4E" android:textSize="11sp"/>

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/okButton"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/fire_button"
            android:text="OK" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="15sp"
            android:stateListAnimator="@null" android:visibility="gone"/>

    </LinearLayout>

</FrameLayout>
