<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/liquid_bg">

    <!-- Ambient liquid orbs -->
    <View android:layout_width="340dp" android:layout_height="340dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-120dp" android:layout_marginStart="-100dp"
        android:background="@drawable/orb_cyan"/>
    <View android:layout_width="300dp" android:layout_height="300dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-90dp" android:layout_marginEnd="-80dp"
        android:background="@drawable/orb_violet"/>
    <View android:layout_width="220dp" android:layout_height="220dp"
        android:layout_gravity="center"
        android:layout_marginTop="240dp"
        android:background="@drawable/orb_pink" android:alpha="0.6"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="match_parent">

        <!-- Glass logo container -->
        <FrameLayout android:id="@+id/splashLogo"
            android:layout_width="150dp" android:layout_height="150dp"
            android:background="@drawable/glass_card" android:padding="16dp"
            android:alpha="0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="130dp">

            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/ark_logo_circle" android:scaleType="fitCenter"/>
        </FrameLayout>

        <!-- Ark Cheat cursive -->
        <TextView android:id="@+id/splashTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ark Cheat"
            android:textColor="#FFFFFF" android:textSize="46sp"
            android:fontFamily="@font/pacifico"
            android:shadowColor="#FFFF5900"
            android:shadowDx="0" android:shadowDy="0" android:shadowRadius="26"
            android:alpha="0"
            app:layout_constraintTop_toBottomOf="@id/splashLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"/>

        <View android:layout_width="120dp" android:layout_height="2dp"
            android:background="#FF5900" android:alpha="0"
            android:id="@+id/splashDivider"
            app:layout_constraintTop_toBottomOf="@id/splashTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <TextView android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DOMINATE  ·  UNDETECTED"
            android:textColor="#FF5900" android:textSize="10sp"
            android:letterSpacing="0.18" android:alpha="0"
            app:layout_constraintTop_toBottomOf="@id/splashDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

        <TextView android:id="@+id/splashTagline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PREMIUM · STABLE · SECURE"
            android:textColor="#9A8C7A" android:textSize="9sp"
            android:letterSpacing="0.18" android:alpha="0"
            android:background="@drawable/glass_pill"
            android:paddingHorizontal="16dp" android:paddingVertical="7dp"
            app:layout_constraintTop_toBottomOf="@id/splashSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="18dp"/>

        <TextView android:id="@+id/splashVersion"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:visibility="gone"
            android:textColor="#6E5F4E" android:textSize="10sp" android:alpha="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="22dp" android:layout_marginEnd="22dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
