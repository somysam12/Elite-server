<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card"
    android:orientation="vertical"
    android:padding="28dp"
    android:layout_margin="12dp">

    <!-- Title row with icon -->
    <LinearLayout
        android:id="@+id/update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/dialog_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ark_logo"
            android:background="@null"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bottom_sheet_dialog_layout_title_text"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"/>
    </LinearLayout>

    <!-- Message -->
    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bottom_sheet_dialog_layout_msg_text"
        android:textColor="#9A8C7A"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginBottom="24dp"/>

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancle"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/glass_input"
            android:text="@string/bottom_sheet_dialog_layout_btn_cancle_text"
            android:textColor="#9A8C7A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

        <Button
            android:id="@+id/btn"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/glass_input"
            android:text="OTHER"
            android:textColor="#FFC021"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

        <Button
            android:id="@+id/updateee"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/liquid_button"
            android:text="PROTECTION"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"/>
    </LinearLayout>

</LinearLayout>
