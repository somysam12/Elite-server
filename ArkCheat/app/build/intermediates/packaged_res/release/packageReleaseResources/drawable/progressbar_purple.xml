<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="50dp"/>
            <solid android:color="#0C1428"/>
            <stroke android:width="0.8dp" android:color="#1E3660"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle">
            <corners android:radius="50dp"/>
            <gradient android:type="linear" android:angle="0"
                android:startColor="#2B6BFF" android:centerColor="#5FA8FF" android:endColor="#7A3FFF"/>
        </shape></clip>
    </item>
</layer-list>
