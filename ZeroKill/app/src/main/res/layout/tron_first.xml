<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zk_bg"
    android:clipToPadding="false">

    <View
        android:id="@+id/bg_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.04"
        android:background="@drawable/zk_scanlines" />

    <View
        android:id="@+id/center_glow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_centerInParent="true"
        android:background="@drawable/zk_radial_glow"
        android:alpha="0" />

    <ImageView
        android:id="@+id/img1"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginBottom="40dp"
        android:src="@drawable/zk_dragon"
        android:background="@null"
        android:scaleType="fitCenter"
        android:alpha="0"
        android:elevation="8dp" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/img1"
        android:layout_marginTop="12dp"
        android:text="ZERO KILL"
        android:textSize="34sp"
        android:textColor="@color/zk_text_primary"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.18"
        android:alpha="0" />

    <TextView
        android:id="@+id/tv_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_app_name"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="10sp"
        android:textColor="@color/zk_ice_bright"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.25"
        android:alpha="0"
        android:visibility="gone" />

    <View
        android:id="@+id/fire_line"
        android:layout_width="180dp"
        android:layout_height="2dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_app_name"
        android:layout_marginTop="16dp"
        android:background="@drawable/zk_fire_line"
        android:alpha="0" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:text="v4.6"
        android:textSize="11sp"
        android:textColor="@color/zk_text_dim"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.15"
        android:alpha="0" />

</RelativeLayout>
