<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zk_bg">

    <!-- Top fire accent -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/zk_fire_line"
        android:layout_alignParentTop="true" />

    <!-- ── TOP BAR ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:background="@color/zk_surface"
        android:layout_alignParentTop="true">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/appNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="ZERO KILL"
            android:textSize="20sp"
            android:textColor="@color/zk_fire_bright"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.12" />

        <!-- Status indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot_green"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE"
                android:textSize="9sp"
                android:textColor="@color/zk_ice_bright"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.15" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider under top bar -->
    <View
        android:id="@+id/top_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/zk_fire_line"
        android:alpha="0.5"
        android:layout_below="@id/top_bar" />

    <!-- ── MAIN SCROLL CONTENT ────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_divider"
        android:layout_above="@+id/bottom_bar"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- ── EXPIRY / TIMER CARD ──────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/zk_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Expiry date -->
                    <TextView
                        android:id="@+id/expiryDateTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Expires —"
                        android:textSize="12sp"
                        android:textColor="@color/zk_text_secondary"
                        android:fontFamily="@font/rajdhani_bold"
                        android:letterSpacing="0.05"
                        android:gravity="center"
                        android:layout_marginBottom="14dp" />

                    <!-- Countdown digits -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Days -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvD"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00"
                                android:textSize="36sp"
                                android:textColor="@color/zk_fire_bright"
                                android:fontFamily="@font/rajdhani_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="9sp"
                                android:textColor="@color/zk_text_dim"
                                android:fontFamily="@font/rajdhani_bold"
                                android:letterSpacing="0.15" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textSize="30sp"
                            android:textColor="@color/zk_fire_mid"
                            android:fontFamily="@font/rajdhani_bold"
                            android:layout_marginBottom="10dp" />

                        <!-- Hours -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvH"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00"
                                android:textSize="36sp"
                                android:textColor="@color/zk_fire_bright"
                                android:fontFamily="@font/rajdhani_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HRS"
                                android:textSize="9sp"
                                android:textColor="@color/zk_text_dim"
                                android:fontFamily="@font/rajdhani_bold"
                                android:letterSpacing="0.15" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textSize="30sp"
                            android:textColor="@color/zk_fire_mid"
                            android:fontFamily="@font/rajdhani_bold"
                            android:layout_marginBottom="10dp" />

                        <!-- Minutes -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvM"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00"
                                android:textSize="36sp"
                                android:textColor="@color/zk_fire_bright"
                                android:fontFamily="@font/rajdhani_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MIN"
                                android:textSize="9sp"
                                android:textColor="@color/zk_text_dim"
                                android:fontFamily="@font/rajdhani_bold"
                                android:letterSpacing="0.15" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textSize="30sp"
                            android:textColor="@color/zk_fire_mid"
                            android:fontFamily="@font/rajdhani_bold"
                            android:layout_marginBottom="10dp" />

                        <!-- Seconds -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvS"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00"
                                android:textSize="36sp"
                                android:textColor="@color/zk_fire_bright"
                                android:fontFamily="@font/rajdhani_bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SEC"
                                android:textSize="9sp"
                                android:textColor="@color/zk_text_dim"
                                android:fontFamily="@font/rajdhani_bold"
                                android:letterSpacing="0.15" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── DEVICE INFO ROW ──────────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/zk_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DEVICE"
                            android:textSize="9sp"
                            android:textColor="@color/zk_ice_bright"
                            android:fontFamily="@font/rajdhani_bold"
                            android:letterSpacing="0.2" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/zk_card_border"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NON-ROOT DEVICE"
                                android:textSize="9sp"
                                android:textColor="#FFFF4500"
                                android:fontFamily="@font/rajdhani_bold"
                                android:letterSpacing="0.1" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/deviceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="@color/zk_text_primary"
                        android:fontFamily="@font/rajdhani_bold" />

                    <!-- BGMI installed indicator -->
                    <LinearLayout
                        android:id="@+id/bgmiInstalledRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/status_dot_green"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GAME READY"
                            android:textSize="11sp"
                            android:textColor="@color/zk_ice_bright"
                            android:fontFamily="@font/rajdhani_bold"
                            android:letterSpacing="0.1" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── LICENSE STATUS LAYOUT (visible when idle/ready) ─────────── -->
            <LinearLayout
                android:id="@+id/licenseLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/zk_ice_mid"
                    android:fontFamily="@font/rajdhani_bold"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <!-- ── PROCESSING LAYOUT (shown during OBB copy, gone by default) → -->
            <LinearLayout
                android:id="@+id/processingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/zk_card_border"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/zk_fire_line"
                    android:alpha="0.6"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/syncText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/zk_fire_bright"
                    android:fontFamily="@font/rajdhani_bold"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/obbProgressBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progressTint="@color/zk_fire_mid"
                    android:progressBackgroundTint="@color/zk_border"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/obbSizeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/zk_text_dim"
                        android:fontFamily="@font/rajdhani_bold" />

                    <TextView
                        android:id="@+id/obbPercentText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/zk_fire_bright"
                        android:fontFamily="@font/rajdhani_bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- OK button (hidden, used by BaseActivity in some flows) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOk"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/zk_btn_ghost"
                android:text="OK"
                android:textColor="@color/zk_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- ── BOTTOM LAUNCH BUTTON ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="20dp"
        android:paddingTop="12dp"
        android:background="@color/zk_surface"
        android:layout_alignParentBottom="true">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/zk_fire_line"
            android:alpha="0.4"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startgame"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/ark_btn_launch"
            android:text="LAUNCH GAME"
            android:textColor="@color/zk_text_primary"
            android:textSize="15sp"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.12"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom border -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:background="@color/zk_border" />

</RelativeLayout>
