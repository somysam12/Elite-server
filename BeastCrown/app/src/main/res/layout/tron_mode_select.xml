<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/fire_bg">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="58dp" android:paddingStart="22dp"
            android:paddingEnd="22dp" android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <!-- Cursive title -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BEASTCROWN"
                android:textColor="#FFFFFF" android:textSize="44sp"
                android:fontFamily="@font/pacifico"
                android:shadowColor="#FF2E7CFF"
                android:shadowDx="0" android:shadowDy="0" android:shadowRadius="30"
                android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SELECT INJECTION MODE"
                android:textColor="#2E7CFF" android:textSize="11sp"
                android:letterSpacing="0.20" android:layout_marginBottom="8dp"/>

            <!-- thin fire divider -->
            <View android:layout_width="60dp" android:layout_height="2dp"
                android:background="#2E7CFF" android:layout_marginBottom="38dp"/>

            <!-- AUTO MODE CARD -->
            <LinearLayout android:id="@+id/cardAuto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/mode_card_unselected"
                android:orientation="vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingTop="22dp" android:paddingBottom="22dp"
                android:layout_marginBottom="18dp"
                android:clickable="true" android:focusable="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">

                    <FrameLayout android:layout_width="54dp" android:layout_height="54dp"
                        android:background="@drawable/mode_icon_bg"
                        android:layout_marginEnd="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:text="⚡" android:textSize="26sp" android:gravity="center"
                            android:textColor="#FFFFFF"/>
                    </FrameLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Auto Mode" android:textColor="#FFFFFF"
                            android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="External · Automatic · BulletTrack"
                            android:textColor="#A89A88" android:textSize="12sp"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <ImageView android:id="@+id/checkAuto"
                        android:layout_width="26dp" android:layout_height="26dp"
                        android:src="@drawable/ic_check" android:visibility="invisible"/>
                </LinearLayout>

                <!-- Preview dropdown (in-game dialog image) -->
                <LinearLayout android:id="@+id/previewAuto"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone"
                    android:layout_marginTop="18dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="180dp"
                        android:src="@drawable/preview_auto" android:scaleType="centerCrop"
                        android:background="@drawable/preview_frame"
                        android:padding="2dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/fire_pill"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="6dp" android:paddingBottom="6dp"
                        android:layout_marginTop="12dp" android:layout_gravity="center_horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Yes = Aimbot   ·   No = BulletTrack"
                            android:textColor="#FFC021" android:textSize="11sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- IMGUI MODE CARD (HIDDEN) -->
            <LinearLayout android:id="@+id/cardImgui"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/mode_card_unselected"
                android:orientation="vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingTop="22dp" android:paddingBottom="22dp"
                android:layout_marginBottom="28dp"
                android:visibility="gone"
                android:clickable="true" android:focusable="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">

                    <FrameLayout android:layout_width="54dp" android:layout_height="54dp"
                        android:background="@drawable/mode_icon_bg"
                        android:layout_marginEnd="18dp">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:text="◈" android:textSize="24sp" android:gravity="center"
                            android:textColor="#FFFFFF"/>
                    </FrameLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="imGui Mode" android:textColor="#FFFFFF"
                            android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Internal UI · Overlay Menu · ESP"
                            android:textColor="#A89A88" android:textSize="12sp"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <ImageView android:id="@+id/checkImgui"
                        android:layout_width="26dp" android:layout_height="26dp"
                        android:src="@drawable/ic_check" android:visibility="invisible"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/previewImgui"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone"
                    android:layout_marginTop="18dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="180dp"
                        android:src="@drawable/preview_imgui" android:scaleType="centerCrop"
                        android:background="@drawable/preview_frame"
                        android:padding="2dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mod Menu · Visuals · Combat · Misc tabs"
                        android:textColor="#FFC021" android:textSize="11sp"
                        android:layout_marginTop="12dp" android:layout_gravity="center_horizontal"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CONTINUE BUTTON -->
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnNext"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:background="@drawable/btn_asur_red"
                android:text="CONTINUE"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:letterSpacing="0.16" android:alpha="0.5"
                android:stateListAnimator="@null"/>

            <TextView android:id="@+id/hintText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Select a mode to continue"
                android:textColor="#8A7A6A" android:textSize="11sp"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom download dialog -->
    <LinearLayout android:id="@+id/dlDialog"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/fire_launch_card"
        android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="22dp" android:paddingBottom="28dp"
        android:layout_margin="16dp"
        android:visibility="gone">

        <TextView android:id="@+id/dlStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DOWNLOADING" android:textColor="#FFFFFF"
            android:textSize="15sp" android:textStyle="bold"
            android:letterSpacing="0.1" android:layout_marginBottom="4dp"/>

        <TextView android:id="@+id/dlSub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Please wait..." android:textColor="#A89A88"
            android:textSize="12sp" android:layout_marginBottom="16dp"/>

        <ProgressBar android:id="@+id/dlProgress"
            android:layout_width="match_parent" android:layout_height="8dp"
            android:progressDrawable="@drawable/progressbar_purple"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100" android:progress="0"
            android:layout_marginBottom="10dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/dlSize"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 MB / 0 MB" android:textColor="#2E7CFF"
                android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/dlSpeed"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#A89A88"
                android:textSize="12sp" android:layout_marginEnd="12dp"/>
            <TextView android:id="@+id/dlPercent"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0%" android:textColor="#FF3D0A"
                android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
