<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#080400">
    <View android:layout_width="300dp" android:layout_height="300dp"
        android:layout_alignParentTop="true" android:layout_alignParentEnd="true"
        android:layout_marginTop="-90dp" android:layout_marginEnd="-90dp"
        android:background="@drawable/bc_orb_fire" android:alpha="0.12"/>
    <View android:layout_width="260dp" android:layout_height="260dp"
        android:layout_alignParentBottom="true" android:layout_alignParentStart="true"
        android:layout_marginBottom="-70dp" android:layout_marginStart="-70dp"
        android:background="@drawable/bc_orb_gold" android:alpha="0.10"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:paddingHorizontal="16dp" android:paddingTop="20dp" android:paddingBottom="20dp">
            <!-- Header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView android:id="@+id/appNameText"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BEASTCROWN" android:textColor="#FFC021"
                    android:textSize="26sp" android:textStyle="bold"
                    android:fontFamily="@font/en_regular" android:letterSpacing="0.08"
                    android:shadowColor="#FFFFC021" android:shadowRadius="16"
                    android:shadowDx="0" android:shadowDy="0"/>
                <ImageView android:layout_width="52dp" android:layout_height="52dp"
                    android:src="@drawable/bc_logo" android:scaleType="fitCenter"/>
            </LinearLayout>
            <!-- Subscription card -->
            <LinearLayout android:id="@+id/licenseLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:background="@drawable/bc_card"
                android:padding="16dp" android:layout_marginBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Subscription ends in" android:textColor="#A08040"
                    android:textSize="11sp" android:fontFamily="@font/poppins_medium"
                    android:layout_marginBottom="12dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center" android:layout_marginEnd="6dp">
                        <TextView android:id="@+id/tvD"
                            android:layout_width="match_parent" android:layout_height="56dp"
                            android:background="@drawable/bc_time_box"
                            android:gravity="center" android:text="00"
                            android:textColor="#FFC021" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="DAY" android:textColor="#5A4020" android:textSize="9sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center" android:layout_marginEnd="6dp">
                        <TextView android:id="@+id/tvH"
                            android:layout_width="match_parent" android:layout_height="56dp"
                            android:background="@drawable/bc_time_box"
                            android:gravity="center" android:text="00"
                            android:textColor="#FFC021" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="HRS" android:textColor="#5A4020" android:textSize="9sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center" android:layout_marginEnd="6dp">
                        <TextView android:id="@+id/tvM"
                            android:layout_width="match_parent" android:layout_height="56dp"
                            android:background="@drawable/bc_time_box"
                            android:gravity="center" android:text="00"
                            android:textColor="#FFC021" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="MIN" android:textColor="#5A4020" android:textSize="9sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:id="@+id/tvS"
                            android:layout_width="match_parent" android:layout_height="56dp"
                            android:background="@drawable/bc_time_box"
                            android:gravity="center" android:text="00"
                            android:textColor="#FF8C00" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SEC" android:textColor="#5A4020" android:textSize="9sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/statusText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" android:textColor="#FFC021" android:textSize="12sp"
                    android:layout_marginTop="8dp" android:visibility="gone"/>
                <TextView android:id="@+id/expiryDateTv"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" android:textColor="#5A4020" android:textSize="11sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
            <!-- Games label -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="AVAILABLE GAMES" android:textColor="#5A4020"
                android:textSize="10sp" android:textStyle="bold"
                android:fontFamily="@font/poppins_medium" android:letterSpacing="0.20"
                android:layout_marginBottom="10dp"/>
            <!-- Game card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bc_card"
                android:padding="16dp" android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">
                    <ImageView android:id="@+id/gameIcon"
                        android:layout_width="60dp" android:layout_height="60dp"
                        android:src="@drawable/bc_logo" android:scaleType="fitCenter"
                        android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/gameName"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Battleground Mobile India"
                            android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                            android:fontFamily="@font/poppins_medium"/>
                        <TextView android:id="@+id/gameDesc"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Version : 4.6"
                            android:textColor="#A08040" android:textSize="12sp"
                            android:fontFamily="@font/poppins_medium" android:layout_marginTop="2dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pkg : com.pubg.imobile"
                            android:textColor="#5A4020" android:textSize="11sp"
                            android:fontFamily="@font/poppins_medium" android:layout_marginTop="2dp"/>
                        <LinearLayout android:id="@+id/bgmiInstalledRow"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <View android:layout_width="5dp" android:layout_height="5dp"
                                android:layout_marginEnd="5dp" android:background="@drawable/bc_status_dot"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Mode : Safe" android:textColor="#FFD700"
                                android:textSize="11sp" android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/startgame"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:background="@drawable/bc_btn_primary_ripple"
                    android:text="LAUNCH GAME" android:textColor="#000000"
                    android:textSize="15sp" android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:letterSpacing="0.14" android:gravity="center"
                    android:layout_marginBottom="10dp" android:visibility="gone"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnOk"
                    android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/bc_btn_primary_ripple"
                    android:text="COPY GAME DATA + OBB"
                    android:textColor="#000000" android:textSize="12sp"
                    android:textStyle="bold" android:fontFamily="@font/poppins_medium"
                    android:letterSpacing="0.06" android:gravity="center"
                    android:layout_marginTop="8dp" android:visibility="gone"/>
            </LinearLayout>
            <!-- OBB processing -->
            <LinearLayout android:id="@+id/processingLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bc_card"
                android:padding="16dp" android:layout_marginBottom="12dp"
                android:gravity="center_horizontal" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SYNCING GAME DATA" android:textColor="#FFC021"
                    android:textSize="13sp" android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium" android:letterSpacing="0.10"/>
                <TextView android:id="@+id/obbSizeText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" android:textColor="#FFC021" android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" android:gravity="center"
                    android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/syncText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Copying files..." android:textColor="#5A4020"
                    android:textSize="12sp" android:gravity="center"
                    android:fontFamily="@font/poppins_medium" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/downloadSizeText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" android:textColor="#3A2A10" android:textSize="11sp"
                    android:gravity="center" android:layout_marginTop="4dp"/>
                <ProgressBar android:id="@+id/obbProgressBar"
                    android:layout_width="match_parent" android:layout_height="6dp"
                    android:progressDrawable="@drawable/bc_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:max="100" android:progress="0" android:layout_marginTop="10dp"/>
                <TextView android:id="@+id/obbPercentText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0%" android:textColor="#FFC021" android:textSize="12sp"
                    android:textStyle="bold" android:fontFamily="@font/poppins_medium"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
            <!-- Device -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="YOUR DEVICE" android:textColor="#3A2A10"
                android:textSize="9sp" android:textStyle="bold"
                android:fontFamily="@font/poppins_medium" android:letterSpacing="0.20"
                android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bc_card" android:padding="14dp">
                <View android:layout_width="3dp" android:layout_height="40dp"
                    android:background="#FFC021" android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/deviceName"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Loading..."
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bc_btn_primary"
                        android:text="BGMI" android:textColor="#000000"
                        android:textSize="11sp" android:textStyle="bold"
                        android:paddingHorizontal="10dp" android:paddingVertical="4dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="6dp">
                        <View android:layout_width="5dp" android:layout_height="5dp"
                            android:background="#FF4500" android:layout_marginEnd="5dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="NON-ROOT DEVICE" android:textColor="#FF4500"
                            android:textSize="9sp" android:fontFamily="@font/poppins_medium"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/bottomCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
