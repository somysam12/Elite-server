<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#080400">
    <View android:layout_width="300dp" android:layout_height="300dp"
        android:layout_alignParentTop="true" android:layout_alignParentEnd="true"
        android:layout_marginTop="-90dp" android:layout_marginEnd="-90dp"
        android:background="@drawable/bc_orb_fire" android:alpha="0.14"/>
    <View android:layout_width="260dp" android:layout_height="260dp"
        android:layout_alignParentBottom="true" android:layout_alignParentStart="true"
        android:layout_marginBottom="-70dp" android:layout_marginStart="-70dp"
        android:background="@drawable/bc_orb_gold" android:alpha="0.12"/>
    <LinearLayout android:id="@+id/mainContent"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingHorizontal="28dp">
        <ImageView android:layout_width="110dp" android:layout_height="110dp"
            android:src="@drawable/bc_logo" android:scaleType="fitCenter"
            android:layout_marginBottom="14dp"/>
        <TextView android:id="@+id/splashTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BEASTCROWN" android:textColor="#FFC021"
            android:textSize="28sp" android:textStyle="bold"
            android:fontFamily="@font/en_regular" android:letterSpacing="0.16"
            android:shadowColor="#FFFFC021" android:shadowRadius="18"
            android:shadowDx="0" android:shadowDy="0" android:layout_marginBottom="24dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="LICENSE KEY" android:textColor="#3A2A10" android:textSize="9sp"
            android:fontFamily="@font/poppins_medium" android:letterSpacing="0.25"
            android:layout_marginBottom="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
            android:background="@drawable/bc_input"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="4dp"
            android:layout_marginBottom="12dp">
            <EditText android:id="@+id/et1"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@android:color/transparent"
                android:hint="Enter license key" android:textColorHint="#2A1A00"
                android:textColor="#FFC021" android:textSize="14sp"
                android:inputType="textPassword" android:singleLine="true"
                android:fontFamily="@font/poppins_medium"/>
            <ImageButton android:id="@+id/img1"
                android:layout_width="50dp" android:layout_height="50dp"
                android:src="@drawable/ic_paste_v2"
                android:background="@android:color/transparent"
                android:scaleType="center" android:padding="12dp"
                android:contentDescription="Paste"/>
            <ImageButton android:id="@+id/eyeToggle"
                android:layout_width="50dp" android:layout_height="50dp"
                android:src="@drawable/ic_eye_off"
                android:background="@android:color/transparent"
                android:scaleType="center" android:padding="12dp"
                android:contentDescription="Toggle"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView android:id="@+id/btnSignIn"
            android:layout_width="match_parent" android:layout_height="56dp"
            app:cardBackgroundColor="#00000000" app:cardCornerRadius="12dp"
            app:cardElevation="0dp" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bc_btn_primary_ripple" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AUTHENTICATE" android:textColor="#000000"
                    android:textSize="15sp" android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium" android:letterSpacing="0.12"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/btnFbClone"
            android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#00000000" app:cardCornerRadius="10dp"
            app:cardElevation="0dp" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bc_btn_secondary_ripple" android:gravity="center">
                <TextView android:id="@+id/btnFbCloneText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CONNECT FACEBOOK" android:textColor="#FFC021"
                    android:textSize="12sp" android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium" android:letterSpacing="0.08"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <LinearLayout android:id="@+id/processingCard"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bc_card"
        android:orientation="vertical" android:padding="22dp"
        android:gravity="center_horizontal" android:visibility="gone">
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@drawable/bc_divider" android:layout_marginBottom="14dp" android:alpha="0.6"/>
        <TextView android:id="@+id/versionText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:visibility="gone" android:textColor="#2A1A00" android:textSize="9sp"/>
        <TextView android:id="@+id/loadingText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FFC021" android:textSize="15sp"
            android:textStyle="bold" android:fontFamily="@font/poppins_medium" android:layout_marginBottom="6dp"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp" android:layout_marginBottom="6dp">
            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="20dp" android:layout_height="20dp"
                android:indeterminate="true" style="?android:attr/progressBarStyle"
                android:indeterminateTint="#FFC021" android:layout_marginEnd="12dp"/>
            <TextView android:id="@+id/progressText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Verifying License" android:textColor="#5A4020"
                android:textSize="13sp" android:fontFamily="@font/poppins_medium"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#0A0600" android:layout_marginTop="10dp" android:layout_marginBottom="10dp"/>
        <TextView android:id="@+id/downloadSizeText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FFC021" android:textSize="14sp"
            android:textStyle="bold" android:fontFamily="@font/poppins_medium"
            android:gravity="center" android:visibility="gone" android:layout_marginBottom="8dp"/>
        <ProgressBar android:id="@+id/downloadProgressBar"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:progressDrawable="@drawable/bc_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100" android:progress="0" android:visibility="gone"/>
        <TextView android:id="@+id/percentText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FFC021" android:textSize="12sp"
            android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp" android:visibility="gone"/>
        <LinearLayout android:id="@+id/speedRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:visibility="gone" android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="" android:textColor="#2A1A00" android:textSize="12sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFC021" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/speedText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#1A0F00" android:textSize="10sp"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/okButton"
            android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bc_btn_primary_ripple"
            android:text="DISMISS" android:textColor="#000000"
            android:textStyle="bold" android:textSize="13sp"
            android:fontFamily="@font/poppins_medium" android:visibility="gone"/>
    </LinearLayout>
</RelativeLayout>
