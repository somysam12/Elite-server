<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#080400">
    <View android:layout_width="380dp" android:layout_height="380dp"
        android:layout_gravity="top|end" android:layout_marginTop="-130dp" android:layout_marginEnd="-130dp"
        android:background="@drawable/bc_orb_fire" android:alpha="0.15"/>
    <View android:layout_width="340dp" android:layout_height="340dp"
        android:layout_gravity="bottom|start" android:layout_marginBottom="-110dp" android:layout_marginStart="-110dp"
        android:background="@drawable/bc_orb_gold" android:alpha="0.12"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/splashGroup"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <ImageView android:id="@+id/splashLogo"
                android:layout_width="160dp" android:layout_height="160dp"
                android:layout_marginBottom="22dp"
                android:src="@drawable/bc_logo" android:scaleType="fitCenter"/>
            <TextView android:id="@+id/splashTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BEASTCROWN" android:textColor="#FFC021"
                android:textSize="34sp" android:textStyle="bold"
                android:fontFamily="@font/en_regular" android:letterSpacing="0.18"
                android:shadowColor="#FFFFC021" android:shadowRadius="22"
                android:shadowDx="0" android:shadowDy="0"/>
            <View android:layout_width="200dp" android:layout_height="1dp"
                android:background="@drawable/bc_divider"
                android:layout_marginTop="16dp" android:alpha="0.7"/>
            <TextView android:id="@+id/splashSubtitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="THE APEX PREDATOR ARRIVES"
                android:textColor="#5A4020" android:textSize="10sp"
                android:fontFamily="@font/poppins_medium" android:letterSpacing="0.22"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
        <TextView android:id="@+id/splashTagline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/splashGroup"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        <TextView android:id="@+id/splashVersion"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="20dp" android:layout_marginEnd="20dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="v4.6" android:textColor="#2A1800" android:textSize="10sp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="20dp" android:layout_marginEnd="20dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
